<?xml version="1.0" encoding="utf-8"?>
<!--
  This is NOT a full generated Android project — see mobile/android/README.md.
  It's the manifest additions/service declarations needed for the
  always-listening foreground service (section 4.3), meant to be merged
  into the manifest that `npx react-native init` (or the RN CLI's Android
  template) generates.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Android 14+ (API 34) requires a specific foreground service type. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Android 13+ (API 33) requires runtime request for notification permission too. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <service
            android:name="com.oreo.wakeword.WakeWordForegroundService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="microphone" />
    </application>

</manifest>
