# Copy this file to .env and fill in real values. Never commit .env.

# --- App ---
OREO_ENV=development
LOG_LEVEL=INFO

# --- Auth / JWT ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=changeme-generate-a-real-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Device pairing ---
# Shared code an admin gives new devices to complete the first pairing handshake.
# Rotate this periodically; it is NOT a long-term credential.
DEVICE_PAIRING_CODE=changeme-pairing-code

# --- Encryption at rest (AES-256) ---
# 32 url-safe base64 bytes, e.g.: python -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# See backend/app/crypto.py and README "Key management" section for rotation guidance.
DATA_ENCRYPTION_KEY=changeme-generate-a-32-byte-key

# --- Database ---
# SQLite (default, personal use):
DATABASE_URL=sqlite:///./data/oreo.db
# Postgres (team deployments):
# DATABASE_URL=postgresql+psycopg2://oreo:oreo@localhost:5432/oreo

# --- Vector store ---
CHROMA_PERSIST_DIR=./data/chroma
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Speech to text ---
# tiny | base | small | medium | large-v3 | large-v3-turbo
# Default is small on purpose so local dev doesn't require a multi-GB download.
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# --- Reasoning agent ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
ENABLE_WEB_SEARCH_TOOL=true

# --- Text to speech ---
# piper | pyttsx3
TTS_BACKEND=pyttsx3
PIPER_MODEL_PATH=./data/tts/en_US-lessac-medium.onnx

# --- Data retention ---
# If false (default), raw audio is deleted immediately after transcription.
RETAIN_RAW_AUDIO=false
